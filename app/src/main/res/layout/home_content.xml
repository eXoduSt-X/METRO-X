<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1E1E1E"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <include
        android:id="@+id/abs_playlists"
        layout="@layout/abs_playlists" />

    <LinearLayout
        android:id="@+id/contentPadding"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">


        <FrameLayout
            android:id="@+id/videoContainer"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:background="#000000">

            <code.name.monkey.retromusic.fragments.home.StretchVideoView
                android:id="@+id/videoPlayer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_gravity="center"
                android:layout_marginHorizontal="24dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#00BFFF"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvSubtitleOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:gravity="center"
                android:padding="16dp"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />
        </FrameLayout>

        <SeekBar
            android:id="@+id/videoSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">
            <TextView android:id="@+id/tvCurrentTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/zero_time" android:textColor="#AAAAAA" />
            <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <TextView android:id="@+id/tvTotalTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/zero_time" android:textColor="#AAAAAA" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="25dp"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_marginTop="4dp">
            <Button android:id="@+id/btnPrevVideo" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="2dp" android:backgroundTint="#333333" android:text="⏮" android:textSize="12sp" android:padding="0dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:textAllCaps="false" android:includeFontPadding="false" android:textColor="#FFFFFF" android:gravity="center" />
            <Button android:id="@+id/btnPlayPause" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:backgroundTint="#333333" android:text="▶" android:textSize="12sp" android:padding="0dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:textAllCaps="false" android:includeFontPadding="false" android:textColor="#FFFFFF" android:gravity="center" />
            <Button android:id="@+id/btnNextVideo" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="2dp" android:backgroundTint="#333333" android:text="⏭" android:textSize="12sp" android:padding="0dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:textAllCaps="false" android:includeFontPadding="false" android:textColor="#FFFFFF" android:gravity="center" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/cutRow"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">
            <Button
                android:id="@+id/btnMergeVideos"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:layout_marginHorizontal="2dp"
                android:backgroundTint="#333333"
                android:textColor="#FFFFFF"
                android:text="UNIR"
                android:padding="2dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:gravity="center"
                android:textSize="8sp" />
            <Button
                android:id="@+id/btnSetStart"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:backgroundTint="#333333"
                android:text="@string/open_bracket"
                android:textSize="10sp"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_marginHorizontal="3dp"
                android:layout_gravity="center_vertical"
                android:textColor="#FFFFFF"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
            <EditText
                android:id="@+id/etStartTime"
                android:layout_width="0dp"
                android:layout_weight="1.3"
                android:layout_height="36dp"
                android:hint="@string/inicio"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777"
                android:textSize="10sp"
                android:inputType="text"
                android:autofillHints="none"
                android:backgroundTint="#333333"
                android:layout_gravity="center_vertical"
                android:padding="4dp" />

            <EditText
                android:id="@+id/etEndTime"
                android:layout_width="0dp"
                android:layout_weight="1.3"
                android:layout_height="36dp"
                android:hint="@string/fin"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777"
                android:textSize="10sp"
                android:inputType="text"
                android:autofillHints="none"
                android:backgroundTint="#333333"
                android:layout_gravity="center_vertical"
                android:padding="4dp" />
            <Button
                android:id="@+id/btnSetEnd"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:backgroundTint="#333333"
                android:text="@string/close_bracket"
                android:textSize="10sp"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_gravity="center_vertical"
                android:textColor="#FFFFFF"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
            <Button
                android:id="@+id/btnSplit"
                android:layout_width="0dp"
                android:layout_weight="1.2"
                android:layout_height="match_parent"
                android:backgroundTint="#333333"
                android:text="CORTAR"
                android:textColor="#FFFFFF"
                android:padding="2dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:gravity="center"
                android:textSize="8sp" />

        </LinearLayout>
        <LinearLayout
            android:id="@+id/toolsRow"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <Button android:id="@+id/btnMixVideo" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:backgroundTint="#6200EE" android:text="MULTIPLEX" android:padding="2dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:textAllCaps="false" android:includeFontPadding="false" android:maxLines="2" android:gravity="center" android:textSize="8sp" android:textColor="#FFFFFF" />
            <Button android:id="@+id/btnFullscreen" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:backgroundTint="#333333" android:text="REMUX" android:padding="2dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:textAllCaps="false" android:includeFontPadding="false" android:maxLines="2" android:gravity="center" android:textSize="8sp" android:textColor="#FFFFFF" />
            <Button android:id="@+id/btnLoadSubtitles" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:backgroundTint="#333333" android:text="SUBS" android:padding="2dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:textAllCaps="false" android:includeFontPadding="false" android:maxLines="2" android:gravity="center" android:textSize="8sp" android:textColor="#FFFFFF" />
            <Button android:id="@+id/btnOpenFile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:backgroundTint="#333333" android:text="VIDEO" android:padding="2dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:textAllCaps="false" android:includeFontPadding="false" android:maxLines="2" android:gravity="center" android:textSize="8sp" android:textColor="#FFFFFF" />
            <Button android:id="@+id/btnChooseFolder" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:backgroundTint="#333333" android:text="CARPETA" android:padding="2dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:textAllCaps="false" android:includeFontPadding="false" android:maxLines="2" android:gravity="center" android:textSize="8sp" android:textColor="#FFFFFF" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/extraActionsContainer"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:weightSum="5"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnConvertAudio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:backgroundTint="#333333"
                android:text="→ MP3"
                android:padding="2dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false"
                android:includeFontPadding="false"
                android:textSize="8sp"
                android:textColor="#FFFFFF"
                android:gravity="center" />

            <Button
                android:id="@+id/btnHardcodeSubtitles"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:backgroundTint="#333333"
                android:textColor="#FFFFFF"
                android:text="WRITE"
                android:padding="2dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:gravity="center"
                android:textSize="8sp" />

            <Button
                android:id="@+id/btnCreateVideoFromPhotos"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:backgroundTint="#333333"
                android:textColor="#FFFFFF"
                android:text="SLIDESHOW"
                android:padding="2dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:gravity="center"
                android:textSize="8sp" />

            <Button
                android:id="@+id/btnCreateGif"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:backgroundTint="#333333"
                android:textColor="#FFFFFF"
                android:text="→ GIF"
                android:padding="2dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:gravity="center"
                android:textSize="8sp" />

            <Button
                android:id="@+id/btnTagEditor"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:backgroundTint="#333333"
                android:textColor="#FFFFFF"
                android:text="MP3TAG"
                android:padding="2dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:gravity="center"
                android:textSize="8sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnYoutubeDownload"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="#333333"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:paddingHorizontal="32dp"
                android:paddingVertical="12dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:src="@drawable/ic_youtube"
                android:contentDescription="YouTube" />

        </FrameLayout>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDownloads"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:nestedScrollingEnabled="true"
            android:layout_marginTop="16dp"
            android:paddingBottom="20dp" />

    </LinearLayout>
</LinearLayout>
