<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1E1E1E"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <include
        android:id="@+id/abs_playlists"
        layout="@layout/abs_playlists" />

        <LinearLayout
        android:id="@+id/contentPadding"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">


        <FrameLayout
            android:id="@+id/videoContainer"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:background="#000000">

            <code.name.monkey.retromusic.fragments.home.StretchVideoView
                android:id="@+id/videoPlayer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="#00BFFF"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvSubtitleOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:gravity="center"
                android:padding="16dp"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />
        </FrameLayout>

        <SeekBar
            android:id="@+id/videoSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">
            <TextView android:id="@+id/tvCurrentTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00:00" android:textColor="#AAAAAA" />
            <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <TextView android:id="@+id/tvTotalTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00:00" android:textColor="#AAAAAA" />
        </LinearLayout>

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:weightSum="3"
    android:layout_marginTop="4dp"> 
    <Button android:id="@+id/btnPrevVideo" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:backgroundTint="#333333" android:text="PREV" android:textSize="8sp" android:drawablePadding="2dp" android:drawableTint="#FFFFFF" />
    <Button android:id="@+id/btnPlayPause" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:backgroundTint="#333333" android:text="PLAY" android:textSize="8sp" android:drawablePadding="2dp" android:drawableTint="#FFFFFF" />
    <Button android:id="@+id/btnNextVideo" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="2dp" android:backgroundTint="#333333" android:text="NEXT" android:textSize="8sp" android:drawablePadding="2dp" android:drawableTint="#FFFFFF" />
</LinearLayout>   
        <LinearLayout
            android:id="@+id/cutRow"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:orientation="horizontal"
    android:layout_marginTop="12dp">
             <Button
        android:id="@+id/btnMergeVideos"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="2dp"
        android:backgroundTint="#333333"
        android:textColor="#FFFFFF"
        android:text="UNIR\nVIDEOS"
        android:maxLines="2"
        android:gravity="center"
        android:textSize="8sp" />
           <Button
                android:id="@+id/btnSetStart"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:backgroundTint="#333333"
                android:text="["
                android:textSize="10sp"
                android:layout_marginHorizontal="3dp" />
            <EditText
                android:id="@+id/etStartTime"
                android:layout_width="0dp"
                android:layout_weight="1.3"
                android:layout_height="40dp"
                android:hint="Inicio"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777"
                android:textSize="10sp"
                android:inputType="text"
                android:backgroundTint="#333333" />

            <EditText
                android:id="@+id/etEndTime"
                android:layout_width="0dp"
                android:layout_weight="1.3"
                android:layout_height="40dp"
                android:hint="Fin"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777"
                android:textSize="10sp"
                android:inputType="text"
                android:backgroundTint="#333333" />
            <Button
                android:id="@+id/btnSetEnd"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:backgroundTint="#333333"
                android:text="]"
                android:textSize="10sp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp" />
   <Button
        android:id="@+id/btnSplit"
        android:layout_width="0dp"
        android:layout_weight="1.0" 
        android:layout_height="match_parent"
        android:backgroundTint="#333333"
        android:text="CORTAR&#10;VIDEO"
        android:textColor="#FFFFFF"
        android:maxLines="2"
        android:gravity="center"
        android:textSize="8sp" />
    
</LinearLayout>
<LinearLayout
    android:id="@+id/toolsRow"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:orientation="horizontal"
    android:layout_marginTop="4dp"> 

    <Button android:id="@+id/btnMixVideo" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:backgroundTint="#6200EE" android:text="CREAR&#10;MKV" android:maxLines="2" android:gravity="center" android:textSize="8sp" />
    <Button android:id="@+id/btnFullscreen" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:backgroundTint="#333333" android:text="CARGAR&#10;MP3" android:maxLines="2" android:gravity="center" android:textSize="8sp" />
    <Button android:id="@+id/btnLoadSubtitles" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:backgroundTint="#333333" android:text="ELEGIR&#10;SRT" android:maxLines="2" android:gravity="center" android:textSize="8sp" />
    <Button android:id="@+id/btnOpenFile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:backgroundTint="#333333" android:text="ELEGIR&#10;VIDEO" android:maxLines="2" android:gravity="center" android:textSize="8sp" />
    <Button android:id="@+id/btnChooseFolder" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:backgroundTint="#333333" android:text="ELEGIR&#10;CARPETA" android:maxLines="2" android:gravity="center" android:textSize="8sp" />
</LinearLayout>
        <LinearLayout
    android:id="@+id/extraActionsContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:weightSum="5"
    android:layout_marginTop="8dp">

    <!-- Aplica exactamente las mismas propiedades a los 4 botones -->
    <Button
        android:id="@+id/btnConvertAudio"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="2dp"
        android:backgroundTint="#333333"
        android:text="CONVERTIDOR MP3"
        android:textSize="8sp" />

    <Button
        android:id="@+id/btnHardcodeSubtitles"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="2dp"
        android:backgroundTint="#333333"
        android:textColor="#FFFFFF"
        android:text="INCRUSTAR\nSUB"
        android:maxLines="2"
        android:gravity="center"
        android:textSize="8sp" />

    <Button
        android:id="@+id/btnCreateVideoFromPhotos"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="2dp"
        android:backgroundTint="#333333"
        android:textColor="#FFFFFF"
        android:text="FOTOS A\nVIDEO"
        android:maxLines="2"
        android:gravity="center"
        android:textSize="8sp" />
<Button
        android:id="@+id/btnCreateGif"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="2dp"
        android:backgroundTint="#333333"
        android:textColor="#FFFFFF"
        android:text="VIDEO A\nGIF"
        android:maxLines="2"
        android:gravity="center"
        android:textSize="8sp" />
            
  <Button
        android:id="@+id/btnTagEditor"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="2dp"
        android:backgroundTint="#333333"
        android:textColor="#FFFFFF"
        android:text="EDITOR\nTAGS"
        android:maxLines="2"
        android:gravity="center"
        android:textSize="8sp" />
   </LinearLayout>


<androidx.recyclerview.widget.RecyclerView
    android:id="@+id/rvDownloads"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:nestedScrollingEnabled="true"
    android:layout_marginTop="16dp"
    android:paddingBottom="20dp" />

    </LinearLayout>
</LinearLayout>
