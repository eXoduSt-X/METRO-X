<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1E1E1E"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <include
        android:id="@+id/abs_playlists"
        layout="@layout/abs_playlists" />

    <LinearLayout
        android:id="@+id/contentPadding"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">


        <FrameLayout
            android:id="@+id/videoContainer"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:background="#000000">

            <code.name.monkey.retromusic.fragments.home.StretchVideoView
                android:id="@+id/videoPlayer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="#00BFFF"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvSubtitleOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:gravity="center"
                android:padding="16dp"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />
        </FrameLayout>

        <SeekBar
            android:id="@+id/videoSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">
            <TextView android:id="@+id/tvCurrentTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/zero_time" android:textColor="#AAAAAA" />
            <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <TextView android:id="@+id/tvTotalTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/zero_time" android:textColor="#AAAAAA" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            style="?android:attr/buttonBarStyle"
            android:weightSum="3"
            android:layout_marginTop="4dp">
            <Button android:id="@+id/btnPrevVideo" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:backgroundTint="#333333" android:text="@string/prev" android:textSize="11sp" style="?android:attr/buttonBarButtonStyle" android:drawablePadding="2dp" android:drawableTint="#FFFFFF" />
            <Button android:id="@+id/btnPlayPause" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:backgroundTint="#333333" android:text="@string/play" android:textSize="11sp" style="?android:attr/buttonBarButtonStyle" android:drawablePadding="2dp" android:drawableTint="#FFFFFF" />
            <Button android:id="@+id/btnNextVideo" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="2dp" android:backgroundTint="#333333" android:text="@string/next" android:textSize="11sp" style="?android:attr/buttonBarButtonStyle" android:drawablePadding="2dp" android:drawableTint="#FFFFFF" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/cutRow"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            style="?android:attr/buttonBarStyle"
            android:layout_marginTop="12dp">
            <Button
                android:id="@+id/btnMergeVideos"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:backgroundTint="#333333"
                android:textColor="#FFFFFF"
                android:text="@string/unir_videos"
                android:maxLines="2"
                android:gravity="center"
                style="?android:attr/buttonBarButtonStyle"
                android:textSize="11sp" />
            <Button
                android:id="@+id/btnSetStart"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:backgroundTint="#333333"
                android:text="@string/open_bracket"
                android:textSize="11sp"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_marginHorizontal="3dp" />
            <EditText
                android:id="@+id/etStartTime"
                android:layout_width="0dp"
                android:layout_weight="1.3"
                android:layout_height="40dp"
                android:hint="@string/inicio"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777"
                android:textSize="11sp"
                android:inputType="text"
                android:autofillHints="none"
                android:backgroundTint="#333333" />

            <EditText
                android:id="@+id/etEndTime"
                android:layout_width="0dp"
                android:layout_weight="1.3"
                android:layout_height="40dp"
                android:hint="@string/fin"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777"
                android:textSize="11sp"
                android:inputType="text"
                android:autofillHints="none"
                android:backgroundTint="#333333" />
            <Button
                android:id="@+id/btnSetEnd"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:backgroundTint="#333333"
                android:text="@string/close_bracket"
                android:textSize="11sp"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp" />
            <Button
    android:id="@+id/btnSplit"
    android:layout_width="0dp"
    android:layout_weight="1.0"
    android:layout_height="match_parent"
    android:backgroundTint="#333333"
    android:text="@string/cortar_video"
    android:textColor="#FFFFFF"
    android:maxLines="2"
    android:gravity="center"
    style="?android:attr/buttonBarButtonStyle"
    android:textSize="11sp"
    android:drawableTop="@drawable/ic_audiotrack.xml"
    android:drawableTint="#FFFFFF"
    android:drawablePadding="2dp" />


        </LinearLayout>
        <LinearLayout
            android:id="@+id/toolsRow"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            style="?android:attr/buttonBarStyle"
            android:layout_marginTop="4dp">

            <Button android:id="@+id/btnMixVideo" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:backgroundTint="#6200EE" android:text="@string/crear_mkv" android:maxLines="2" android:gravity="center" style="?android:attr/buttonBarButtonStyle" android:textSize="11sp" />
            <Button android:id="@+id/btnFullscreen" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:backgroundTint="#333333" android:text="@string/cargar_mp3" android:maxLines="2" android:gravity="center" style="?android:attr/buttonBarButtonStyle" android:textSize="11sp" />
            <Button android:id="@+id/btnLoadSubtitles" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:backgroundTint="#333333" android:text="@string/elegir_srt" android:maxLines="2" android:gravity="center" style="?android:attr/buttonBarButtonStyle" android:textSize="11sp" />
            <Button android:id="@+id/btnOpenFile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:backgroundTint="#333333" android:text="@string/elegir_video" android:maxLines="2" android:gravity="center" style="?android:attr/buttonBarButtonStyle" android:textSize="11sp" />
            <Button android:id="@+id/btnChooseFolder" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:backgroundTint="#333333" android:text="@string/elegir_carpeta" android:maxLines="2" android:gravity="center" style="?android:attr/buttonBarButtonStyle" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/extraActionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            style="?android:attr/buttonBarStyle"
            android:weightSum="6"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnConvertAudio"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:backgroundTint="#333333"
                android:text="@string/convertidor_mp3"
                style="?android:attr/buttonBarButtonStyle"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnHardcodeSubtitles"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:backgroundTint="#333333"
                android:textColor="#FFFFFF"
                android:text="@string/incrustar_sub"
                android:maxLines="2"
                android:gravity="center"
                style="?android:attr/buttonBarButtonStyle"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnCreateVideoFromPhotos"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:backgroundTint="#333333"
                android:textColor="#FFFFFF"
                android:text="@string/fotos_a_video"
                android:maxLines="2"
                android:gravity="center"
                style="?android:attr/buttonBarButtonStyle"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnCreateGif"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:backgroundTint="#333333"
                android:textColor="#FFFFFF"
                android:text="@string/video_a_gif"
                android:maxLines="2"
                android:gravity="center"
                style="?android:attr/buttonBarButtonStyle"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnTagEditor"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:backgroundTint="#333333"
                android:textColor="#FFFFFF"
                android:text="@string/editor_tags"
                android:maxLines="2"
                android:gravity="center"
                style="?android:attr/buttonBarButtonStyle"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnYoutubeDownload"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:backgroundTint="#FF0000"
                android:textColor="#FFFFFF"
                android:text="@string/youtube_mp3"
                android:maxLines="2"
                android:gravity="center"
                style="?android:attr/buttonBarButtonStyle"
                android:textSize="11sp" />
        </LinearLayout>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDownloads"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:nestedScrollingEnabled="true"
            android:layout_marginTop="16dp"
            android:paddingBottom="20dp" />

    </LinearLayout>
</LinearLayout>
