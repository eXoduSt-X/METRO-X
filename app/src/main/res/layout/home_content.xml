<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1E1E1E"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <include
        android:id="@+id/abs_playlists"
        layout="@layout/abs_playlists" />

    <LinearLayout
        android:id="@+id/contentPadding"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">


        <FrameLayout
            android:id="@+id/videoContainer"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:background="#000000">

            <androidx.media3.ui.PlayerView
                android:id="@+id/videoPlayer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                app:use_controller="false"
                app:surface_type="surface_view"
                app:resize_mode="fill" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_gravity="center"
                android:layout_marginHorizontal="24dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#00BFFF"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvSubtitleOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:gravity="center"
                android:padding="16dp"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />
            <TextView
                android:id="@+id/tvResolutionOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:textColor="#CCFFFFFF"
                android:textSize="10sp"
                android:background="#66000000"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <!-- Lista de selección para slideshow/unir videos (no es scrubbing de
                 reproducción, es una lista normal con botones agregar/quitar) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFilmstrip"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="#222222"
                android:orientation="horizontal"
                android:visibility="gone"
                android:clipToPadding="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <!-- Timeline continua de scrubbing para reproducción de video: filmstrip +
                 waveform en un único View, único scroll, única fuente de verdad. -->
            <code.name.monkey.retromusic.views.ScrubHorizontalScrollView
                android:id="@+id/hsvFilmstrip"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:background="#222222"
                android:scrollbars="none"
                android:visibility="gone"
                android:overScrollMode="never"
                android:clipToPadding="false">

                <code.name.monkey.retromusic.views.FilmstripTimelineView
                    android:id="@+id/filmstripTimeline"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent" />

            </code.name.monkey.retromusic.views.ScrubHorizontalScrollView>

            <View
                android:id="@+id/vFilmstripIndicator"
                android:layout_width="2dp"
                android:layout_height="96dp"
                android:layout_gravity="start"
                android:layout_marginStart="0dp"
                android:background="#FF0000"
                android:visibility="gone" />
        </FrameLayout>

        <SeekBar
            android:id="@+id/videoSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">
            <TextView android:id="@+id/tvCurrentTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/zero_time" android:textColor="#AAAAAA" />
            <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <TextView android:id="@+id/tvTotalTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/zero_time" android:textColor="#AAAAAA" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_marginTop="4dp">
            <Button android:id="@+id/btnPrevVideo" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="2dp" android:backgroundTint="#333333" android:text="" android:textSize="12sp" android:padding="0dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:textAllCaps="false" android:includeFontPadding="false" android:textColor="#FFFFFF" android:gravity="center" />
            <Button android:id="@+id/btnPlayPause" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:backgroundTint="#333333" android:text="" android:textSize="12sp" android:padding="0dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:textAllCaps="false" android:includeFontPadding="false" android:textColor="#FFFFFF" android:gravity="center" />
            <Button android:id="@+id/btnNextVideo" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="2dp" android:backgroundTint="#333333" android:text="" android:textSize="12sp" android:padding="0dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:textAllCaps="false" android:includeFontPadding="false" android:textColor="#FFFFFF" android:gravity="center" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/cutRow"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">
            <Button
                android:id="@+id/btnMergeVideos"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:layout_marginHorizontal="2dp"
                android:backgroundTint="#333333"
                android:textColor="#FFFFFF"
                android:text="UNIR"
                android:padding="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:gravity="center"
                android:textSize="8sp" />
            <Button
                android:id="@+id/btnSetStart"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:backgroundTint="#333333"
                android:text="@string/open_bracket"
                android:textSize="10sp"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_marginHorizontal="3dp"
                android:layout_gravity="center_vertical"
                android:textColor="#FFFFFF"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
            <EditText
                android:id="@+id/etStartTime"
                android:layout_width="0dp"
                android:layout_weight="1.3"
                android:layout_height="32dp"
                android:hint="@string/inicio"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777"
                android:textSize="10sp"
                android:inputType="text"
                android:autofillHints="none"
                android:backgroundTint="#333333"
                android:layout_gravity="center_vertical"
                android:padding="4dp" />

            <EditText
                android:id="@+id/etEndTime"
                android:layout_width="0dp"
                android:layout_weight="1.3"
                android:layout_height="32dp"
                android:hint="@string/fin"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777"
                android:textSize="10sp"
                android:inputType="text"
                android:autofillHints="none"
                android:backgroundTint="#333333"
                android:layout_gravity="center_vertical"
                android:padding="4dp" />
            <Button
                android:id="@+id/btnSetEnd"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:backgroundTint="#333333"
                android:text="@string/close_bracket"
                android:textSize="10sp"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_gravity="center_vertical"
                android:textColor="#FFFFFF"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
            <Button
                android:id="@+id/btnSplit"
                android:layout_width="0dp"
                android:layout_weight="1.2"
                android:layout_height="match_parent"
                android:backgroundTint="#333333"
                android:text="CORTAR"
                android:textColor="#FFFFFF"
                android:padding="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:gravity="center"
                android:textSize="8sp" />

        </LinearLayout>
        <LinearLayout
            android:id="@+id/toolsRow"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <Button android:id="@+id/btnMixVideo" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:backgroundTint="#6200EE" android:text="MULTIPLEX" android:padding="0dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:textAllCaps="false" android:includeFontPadding="false" android:maxLines="1" android:gravity="center" android:textSize="8sp" android:textColor="#FFFFFF" />
            <Button android:id="@+id/btnFullscreen" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:backgroundTint="#333333" android:text="REMUX" android:padding="0dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:textAllCaps="false" android:includeFontPadding="false" android:maxLines="1" android:gravity="center" android:textSize="8sp" android:textColor="#FFFFFF" />
            <Button android:id="@+id/btnLoadSubtitles" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:backgroundTint="#333333" android:text="SUBS" android:padding="0dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:textAllCaps="false" android:includeFontPadding="false" android:maxLines="1" android:gravity="center" android:textSize="8sp" android:textColor="#FFFFFF" />
            <Button android:id="@+id/btnSubtitleWorkshop" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:backgroundTint="#333333" android:text="WORKSHOP" android:padding="0dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:textAllCaps="false" android:includeFontPadding="false" android:maxLines="1" android:gravity="center" android:textSize="8sp" android:textColor="#FFFFFF" />
            <Button android:id="@+id/btnOpenFile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:backgroundTint="#333333" android:text="VIDEO" android:padding="0dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:textAllCaps="false" android:includeFontPadding="false" android:maxLines="1" android:gravity="center" android:textSize="8sp" android:textColor="#FFFFFF" />
            <Button android:id="@+id/btnChooseFolder" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:backgroundTint="#333333" android:text="CARPETA" android:padding="0dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:textAllCaps="false" android:includeFontPadding="false" android:maxLines="1" android:gravity="center" android:textSize="8sp" android:textColor="#FFFFFF" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/extraActionsContainer"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:weightSum="5"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnConvertAudio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:backgroundTint="#333333"
                android:text="→ MP3"
                android:padding="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textSize="8sp"
                android:textColor="#FFFFFF"
                android:gravity="center" />

            <Button
                android:id="@+id/btnHardcodeSubtitles"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:backgroundTint="#333333"
                android:textColor="#FFFFFF"
                android:text="WRITE"
                android:padding="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:gravity="center"
                android:textSize="8sp" />

            <Button
                android:id="@+id/btnCreateVideoFromPhotos"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:backgroundTint="#333333"
                android:textColor="#FFFFFF"
                android:text="SLIDESHOW"
                android:padding="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:gravity="center"
                android:textSize="8sp" />

            <Button
                android:id="@+id/btnCreateGif"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:backgroundTint="#333333"
                android:textColor="#FFFFFF"
                android:text="→ GIF"
                android:padding="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:gravity="center"
                android:textSize="8sp" />

            <Button
                android:id="@+id/btnTagEditor"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:backgroundTint="#333333"
                android:textColor="#FFFFFF"
                android:text="MP3TAG"
                android:padding="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:gravity="center"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/assSubsRow"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnHardcodeAssSubtitles"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="2dp"
                android:backgroundTint="#333333"
                android:textColor="#FFFFFF"
                android:text="SUBS SRT/ASS (estilos)"
                android:padding="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:gravity="center"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/fadeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="FADE IN"
                    android:textColor="#AAAAAA"
                    android:textSize="8sp"
                    android:gravity="center"
                    android:layout_marginBottom="2dp" />

                <EditText
                    android:id="@+id/etFadeInDuration"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:hint="Segundos"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#777777"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:inputType="numberDecimal"
                    android:autofillHints="none"
                    android:backgroundTint="#333333"
                    android:padding="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="FADE OUT"
                    android:textColor="#AAAAAA"
                    android:textSize="8sp"
                    android:gravity="center"
                    android:layout_marginBottom="2dp" />

                <EditText
                    android:id="@+id/etFadeOutDuration"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:hint="Segundos"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#777777"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:inputType="numberDecimal"
                    android:autofillHints="none"
                    android:backgroundTint="#333333"
                    android:padding="4dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnApplyFade"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1.2"
                android:layout_marginHorizontal="2dp"
                android:layout_gravity="bottom"
                android:backgroundTint="#333333"
                android:textColor="#FFFFFF"
                android:text="APLICAR FADE"
                android:padding="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:gravity="center"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/subtitleWorkshopContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#222222"
            android:padding="8dp"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SRT SUBTITLE EDITOR"
                android:textColor="#00BFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etSubtitleWorkshop"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:hint="Pega tus letras o subtítulos aquí..."
                android:textColor="#FFFFFF"
                android:textColorHint="#777777"
                android:textSize="12sp"
                android:gravity="top"
                android:background="#333333"
                android:padding="8dp"
                android:layout_marginTop="4dp"
                android:scrollbars="vertical"
                android:inputType="textMultiLine" />
            <EditText
                android:id="@+id/etSubtitleWorkshopTranslation"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:hint="Traducción (opcional) — una línea por cada línea del original, en el mismo orden"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777"
                android:textSize="12sp"
                android:gravity="top"
                android:background="#333333"
                android:padding="8dp"
                android:layout_marginTop="4dp"
                android:scrollbars="vertical"
                android:inputType="textMultiLine" />

            <CheckBox
                android:id="@+id/cbWorkshopMtvInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Agregar info tipo MTV (opcional)"
                android:textColor="#AAAAAA"
                android:textSize="10sp"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:id="@+id/mtvInfoRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_marginTop="4dp">

                <EditText
                    android:id="@+id/etMtvArtist"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="36dp"
                    android:hint="Artista"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#777777"
                    android:textSize="10sp"
                    android:backgroundTint="#333333"
                    android:layout_marginEnd="2dp"
                    android:padding="4dp" />

                <EditText
                    android:id="@+id/etMtvSong"
                    android:layout_width="0dp"
                    android:layout_weight="1.4"
                    android:layout_height="36dp"
                    android:hint="Canción"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#777777"
                    android:textSize="10sp"
                    android:backgroundTint="#333333"
                    android:layout_marginHorizontal="2dp"
                    android:padding="4dp" />

                <EditText
                    android:id="@+id/etMtvYear"
                    android:layout_width="0dp"
                    android:layout_weight="0.6"
                    android:layout_height="36dp"
                    android:hint="Álbum"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#777777"
                    android:textSize="10sp"
                    android:inputType="text"
                    android:backgroundTint="#333333"
                    android:layout_marginStart="2dp"
                    android:padding="4dp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnWorkshopStamp"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="STAMP [TIME]"
                    android:textSize="10sp"
                    android:padding="0dp"
                    android:minHeight="0dp"
                    android:backgroundTint="#008000" />

                <Button
                    android:id="@+id/btnWorkshopClearStamps"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="LIMPIAR TIEMPOS"
                    android:textSize="10sp"
                    android:padding="0dp"
                    android:minHeight="0dp"
                    android:backgroundTint="#444444"
                    android:layout_marginHorizontal="4dp" />

                <Button
                    android:id="@+id/btnWorkshopSave"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="EXPORTAR SRT"
                    android:textSize="10sp"
                    android:padding="0dp"
                    android:minHeight="0dp"
                    android:backgroundTint="#6200EE" />
                <Button
                    android:id="@+id/btnWorkshopExportAss"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="→ ASS"
                    android:textSize="10sp"
                    android:padding="0dp"
                    android:minHeight="0dp"
                    android:backgroundTint="#1976D2"
                    android:layout_marginStart="4dp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnYoutubeDownload"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            android:text=""
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
