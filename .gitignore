# --- MODIFICACIÓN: Gestión de librerías y binarios nativos ---
# Ignora todos los archivos AAR y SO para evitar subirlos al repo
*.aar
*.so

# Pero permitimos específicamente el directorio libs y el AAR necesario para el build
!app/libs/
!app/libs/ffmpeg-kit-16kb-full.aar
# app/libs/*  <-- Comentado para evitar ignorar archivos permitidos
# Y volvemos a ignorar el contenido dentro de libs excepto los permitidos
!app/libs/.gitkeep

# --- Seguridad adicional ---
# Evita subir carpetas de caché de descarga
.gradle/
.navigation/
