# --- MODIFICACIÓN: Gestión de librerías y binarios nativos ---
# Ignora todos los archivos AAR y SO para evitar subirlos al repo
*.aar
*.so

# Pero permitimos específicamente el directorio libs para que el sistema 
# de descarga pueda crear la carpeta necesaria durante el build
!app/libs/
app/libs/*
# Y volvemos a ignorar el contenido dentro de libs para que Git no lo rastree
!app/libs/.gitkeep

# --- Seguridad adicional ---
# Evita subir carpetas de caché de descarga
.gradle/
.navigation/
